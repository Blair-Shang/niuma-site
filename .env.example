# 前端：开发时留空，走 Vite 代理 /api → :8080；生产同域反代也留空
VITE_SITE_API_BASE=

# 版本 / 更新说明 / 反馈（niuma-cloud，含 /cloud 前缀）
# 生产：https://www.niuma007.com/cloud
VITE_CLOUD_API_BASE=http://127.0.0.1:8090/cloud

# cloud 不可达时的展示回落；真实跳转以 server config/app.yaml → download.windows_url 为准
# 勿填 GitHub（暂未开源）；需要时可填自有 CDN
VITE_DOWNLOAD_WIN_URL=
VITE_DOWNLOAD_VERSION=
